# 复制成 .env 后填写真实值；.env 不会被提交
#   PowerShell:  Copy-Item .env.example .env

# ===== 大模型（任何 OpenAI 兼容服务）=====
# 阿里百炼：https://dashscope.aliyuncs.com/compatible-mode/v1  + qwen-plus
# DeepSeek：https://api.deepseek.com                          + deepseek-chat
AI_API_KEY=sk-你的key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# ===== Embedding =====
# 重要：DeepSeek 不提供 /embeddings 接口，向量检索需要单独的 embedding 服务。
# 下面两项留空时，RAG 会自动回退到 BM25 关键词检索（纯本地，零依赖）。
# 想启用向量检索：填阿里百炼的 base_url + key
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=text-embedding-v3

# auto（自动判断）/ vector（强制向量）/ bm25（强制关键词）
RAG_RETRIEVAL_MODE=auto

# ===== Java 业务后端（hmdp）=====
HMDP_BASE_URL=http://127.0.0.1:8081
HMDP_PHONE=13800000000
# 留空则自动登录；也可手动填一个 token
HMDP_TOKEN=

# ===== Redis（验证码 / 会话 / checkpointer）=====
REDIS_URL=redis://:123456@127.0.0.1:6379/1

# ===== 向量库 =====
CHROMA_DIR=./data/chroma

# ===== MinerU 文档解析（可选：解析 PDF / Office / 图片时才需要）=====
# auto   : 配了 token 就用 MinerU，否则回退 pypdf（只抽文本、不联网）
# mineru : 强制用 MinerU（没 token 直接报错）
# pypdf  : 强制只用 pypdf，完全不联网
PARSER=auto
# 在 https://mineru.net/apiManage 申请
MINERU_TOKEN=
# pipeline：快、便宜；vlm：版式复杂或扫描件效果更好
MINERU_MODEL_VERSION=vlm
MINERU_ENABLE_OCR=false
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=ch
MINERU_POLL_INTERVAL=5
MINERU_TIMEOUT=600
# 解析结果缓存目录（按文件内容哈希缓存，避免重复消耗额度）
PARSED_CACHE_DIR=./data/parsed

# ===== 服务 =====
AI_SERVICE_PORT=8000
